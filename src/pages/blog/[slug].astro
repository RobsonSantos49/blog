---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => !data.draft);
  return artigos.map((artigo) => ({
    params: { slug: artigo.id },
    props: { artigo },
  }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout
  title={artigo.data.title}
  description={artigo.data.description}
  type="article"
  publishedDate={artigo.data.pubDate}
  articleAuthor={artigo.data.autor}
>
  <article>
    <a href="/blog" class="text-sm text-brand-600 hover:text-gold-600">← Voltar ao blog</a>

    <header class="mt-4 mb-8 border-b border-brand-100 pb-6">
      <time class="text-xs text-brand-500">
        {artigo.data.pubDate.toLocaleDateString('pt-BR', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
      <h1 class="mt-1 font-serif text-3xl text-brand-900">{artigo.data.title}</h1>
      <p class="mt-2 text-brand-700">{artigo.data.description}</p>
    </header>

    <div class="prose-espirita">
      <Content />
    </div>

    <section class="mt-10 border-t border-brand-100 pt-8">
      <h2 class="mb-4 font-serif text-xl text-brand-800">Comentários</h2>
      <p class="mb-3 text-sm text-brand-500">Deixe seu comentário abaixo.</p>
      <div
        id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id="f412edef-fada-4ca8-9db9-c781aa9baac9"
        data-page-id={artigo.id}
        data-page-url={pageUrl}
        data-page-title={artigo.data.title}
        data-theme="light"
      >
      </div>
      <script defer src="/cusdis-locale-pt-br.js"></script>
      <script defer src="https://cusdis.com/js/cusdis.es.js"></script>
    </section>
  </article>
</Layout>
