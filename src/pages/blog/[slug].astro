---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => !data.draft);
  return artigos.map((artigo) => ({
    params: { slug: artigo.id },
    props: { artigo },
  }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const todosArtigos = (await getCollection('artigos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const indiceAtual = todosArtigos.findIndex((a) => a.id === artigo.id);
const artigoAnterior = indiceAtual > 0 ? todosArtigos[indiceAtual - 1] : undefined;
const proximoArtigo =
  indiceAtual >= 0 && indiceAtual < todosArtigos.length - 1
    ? todosArtigos[indiceAtual + 1]
    : undefined;
---

<Layout
  title={artigo.data.title}
  description={artigo.data.description}
  type="article"
  publishedDate={artigo.data.pubDate}
  articleAuthor={artigo.data.autor}
  breadcrumbs={[{ label: 'Blog', href: '/blog' }, { label: artigo.data.title }]}
  faq={artigo.data.faq}
  image={artigo.data.coverImage}
>
  <article>
    <a href="/blog" class="text-sm text-brand-600 hover:text-gold-600">← Voltar ao blog</a>

    {artigo.data.coverImage && (
      <figure class="mt-4">
        <img
          src={artigo.data.coverImage}
          alt={artigo.data.title}
          class="w-full rounded-lg object-cover"
          style="max-height: 360px;"
          width="1200"
          height="800"
        />
        {artigo.data.coverImageCredit && (
          <figcaption class="mt-1 text-right text-xs text-brand-400">
            {artigo.data.coverImageCredit}
          </figcaption>
        )}
      </figure>
    )}

    <header class="mt-4 mb-8 border-b border-brand-100 pb-6">
      <time class="text-xs text-brand-500">
        {artigo.data.pubDate.toLocaleDateString('pt-BR', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
      <h1 class="mt-1 font-serif text-3xl text-brand-900">{artigo.data.title}</h1>
      <p class="mt-2 text-brand-700">{artigo.data.description}</p>
    </header>

    <div class="prose-espirita">
      <Content />
    </div>

    {artigo.data.faq.length > 0 && (
      <section class="mt-10 border-t border-brand-100 pt-8">
        <h2 class="mb-4 font-serif text-xl text-brand-800">Perguntas frequentes</h2>
        <div class="space-y-3">
          {artigo.data.faq.map((item) => (
            <details class="group rounded-lg border border-brand-100 p-4">
              <summary class="cursor-pointer list-none font-medium text-brand-900 marker:content-none">
                <span class="flex items-center justify-between gap-2">
                  {item.pergunta}
                  <span class="text-brand-400 transition-transform group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-2 text-sm text-brand-700">{item.resposta}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {(artigoAnterior || proximoArtigo) && (
      <nav class="mt-10 grid gap-4 border-t border-brand-100 pt-8 sm:grid-cols-2" aria-label="Navegação entre artigos">
        {artigoAnterior && (
          <a
            href={`/blog/${artigoAnterior.id}`}
            class="rounded-lg border border-brand-100 p-4 transition-shadow hover:shadow-md"
          >
            <span class="text-xs font-medium text-gold-600">← Artigo anterior</span>
            <h3 class="mt-1 font-serif text-base text-brand-900">{artigoAnterior.data.title}</h3>
          </a>
        )}
        {proximoArtigo && (
          <a
            href={`/blog/${proximoArtigo.id}`}
            class="rounded-lg border border-brand-100 p-4 text-right transition-shadow hover:shadow-md sm:col-start-2"
          >
            <span class="text-xs font-medium text-gold-600">Próximo artigo →</span>
            <h3 class="mt-1 font-serif text-base text-brand-900">{proximoArtigo.data.title}</h3>
          </a>
        )}
      </nav>
    )}

    <section class="mt-10 border-t border-brand-100 pt-8">
      <h2 class="mb-4 font-serif text-xl text-brand-800">Comentários</h2>
      <p class="mb-3 text-sm text-brand-500">Deixe seu comentário abaixo.</p>
      <div
        id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id="f412edef-fada-4ca8-9db9-c781aa9baac9"
        data-page-id={artigo.id}
        data-page-url={pageUrl}
        data-page-title={artigo.data.title}
        data-theme="light"
      >
      </div>
      <script defer src="/cusdis-locale-pt-br.js"></script>
      <script defer src="https://cusdis.com/js/cusdis.es.js"></script>
    </section>
  </article>
</Layout>
