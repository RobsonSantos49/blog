---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import IconLivro from '../../components/icons/IconLivro.astro';

export async function getStaticPaths() {
  const obras = await getCollection('obras-basicas');
  return obras.map((obra) => ({
    params: { slug: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;
const { Content } = await render(obra);

const todasObras = (await getCollection('obras-basicas')).sort((a, b) => a.data.ordem - b.data.ordem);
const proximaObra = todasObras.find((o) => o.data.ordem === obra.data.ordem + 1);
---

<Layout
  title={obra.data.title}
  description={obra.data.resumo}
  type="article"
  breadcrumbs={[{ label: 'Obras Básicas', href: '/obras-basicas' }, { label: obra.data.title }]}
  image={obra.data.capaImagem}
>
  <article>
    <a href="/obras-basicas" class="text-sm text-brand-600 hover:text-gold-600">
      ← Voltar às obras básicas
    </a>

    <header class="mt-4 mb-8 flex gap-5 border-b border-brand-100 pb-6">
      {obra.data.capaImagem && (
        <img
          src={obra.data.capaImagem}
          alt={`Capa de ${obra.data.title}`}
          class="h-40 w-auto shrink-0 rounded shadow-sm sm:h-48"
          width="130"
          height="200"
        />
      )}
      <div>
        <span class="flex items-center gap-1.5 text-xs font-medium text-gold-600">
          <IconLivro class="h-4 w-4" />
          {obra.data.ordem}ª obra · {obra.data.anoPublicacao}
        </span>
        <h1 class="mt-1 font-serif text-3xl text-brand-900">{obra.data.title}</h1>
        {obra.data.tituloOriginal && (
          <p class="text-sm text-brand-500 italic">{obra.data.tituloOriginal}</p>
        )}
        <p class="mt-3 text-sm text-brand-500">Por {obra.data.autor}</p>
        {obra.data.arquivoPdf && (
          <a
            href={`/obras-basicas/${encodeURIComponent(obra.data.arquivoPdf)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-fit items-center gap-2 rounded-md bg-brand-700 px-4 py-2 text-sm text-white transition-colors hover:bg-brand-800"
          >
            Baixar PDF
          </a>
        )}
      </div>
    </header>

    <div class="prose-espirita">
      <Content />
    </div>

    {proximaObra && (
      <footer class="mt-10 rounded-lg border border-brand-100 bg-brand-50 p-5">
        <p class="text-xs font-medium text-gold-600">Continue a leitura</p>
        <a
          href={`/obras-basicas/${proximaObra.id}`}
          class="mt-1 block font-serif text-lg text-brand-900 hover:text-brand-700"
        >
          {proximaObra.data.ordem}ª obra: {proximaObra.data.title} →
        </a>
      </footer>
    )}
  </article>
</Layout>
